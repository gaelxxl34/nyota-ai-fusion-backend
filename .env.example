PORT=3000
NODE_ENV=development

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:3001

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
PASSWORD_RESET_URL=http://localhost:3001/reset-password
GMAIL_USER=your-gmail-user
GMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_SERVICE=gmail
EMAIL_FROM="Your App Name <your-email@example.com>"
JWT_SECRET=your-jwt-secret-key

# Add these new variables from your Firebase service account
FIREBASE_PRIVATE_KEY="your-private-key"
FIREBASE_CLIENT_EMAIL=your-client-email

SSL_KEY_PATH=../certificates/key.pem
SSL_CERT_PATH=../certificates/cert.pem

# HTTPS Configuration
HTTPS_PORT=3443
FRONTEND_URL=http://localhost:3001

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_TEST_PHONE_NUMBER=your-test-phone-number
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_WEBHOOK_URL=your-webhook-url

# Anthropic Claude AI Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_AUTO_REPLY_ENABLED=true

# Disable test conversation creation
DISABLE_TEST_ENDPOINTS=true
WEBHOOK_PROTECTION_ENABLED=true
