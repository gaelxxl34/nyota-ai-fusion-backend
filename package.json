{
  "name": "nyota-ai-fusion-backend",
  "version": "1.0.0",
  "description": "Backend service for Nyota AI Fusion",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "send-interested-leads": "node src/scripts/sendInterestedLeadsMessages.js",
    "setup-redis": "./setup-redis.sh",
    "test-cache": "node -e \"const cache = require('./src/services/redisCache.service'); cache.healthCheck().then(console.log);\"",
    "export-interested": "node scripts/export-interested-leads.js --status=INTERESTED",
    "export-all-leads": "node scripts/export-interested-leads.js --all",
    "export-applied": "node scripts/export-interested-leads.js --status=APPLIED",
    "export-qualified": "node scripts/export-interested-leads.js --status=QUALIFIED",
    "export-enrolled": "node scripts/export-interested-leads.js --status=ENROLLED",
    "quick-export": "node scripts/quick-export.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@sendgrid/mail": "^8.1.5",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^11.10.1",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "redis": "^5.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
